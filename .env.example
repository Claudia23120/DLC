# ─────────────────────────────────────────────────────────────
# Colla de Diables de Les Corts — environment variables
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# ── Supabase (cloud project) ──────────────────────────────────
# Project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Bypasses RLS. Never expose to the browser.
# Used for admin-only server actions (e.g. creating member accounts) and
# for the notification fan-out that reads every member's email.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Email notifications (Resend) ──────────────────────────────
# Master switch. Leave "false" until a sending domain is verified in Resend.
# When "false", the app skips sending and just logs what it would have sent.
EMAILS_ENABLED=false

# Resend API key (https://resend.com/api-keys).
RESEND_API_KEY=

# Verified sender. Until diableslescorts.cat is verified in Resend, this must
# stay as a Resend test address and email delivery is limited.
EMAIL_FROM="Colla de Diables de les Corts <avisos@diableslescorts.cat>"

# Optional reply-to shown to members.
EMAIL_REPLY_TO=hola@diableslescorts.cat

# ── App ───────────────────────────────────────────────────────
# Public base URL, used to build links inside notification emails and
# calendar (.ics) files.
SITE_URL=http://localhost:3000
